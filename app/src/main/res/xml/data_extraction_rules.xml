<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ : sauvegarde cloud ET transfert d'appareil à appareil.

   Mêmes exclusions que backup_rules.xml, et pour la même raison : les données chiffrées par
   l'AndroidKeyStore (session Firebase Auth) ne survivent pas au changement d'appareil, la clé
   n'étant pas transférable. `device-transfer` doit donc les exclure aussi — c'est le chemin
   emprunté par les outils de migration constructeur (Smart Switch et équivalents), première
   source de sessions Firebase Auth impossibles à déchiffrer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
