<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème hôte pour l'activité Compose. Material3 + sans ActionBar.
         Le rendu réel (couleurs, typo) est géré par VeloxTheme côté Compose. -->
    <style name="Theme.Velox_client" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Noir : c'est ce fond qui s'affiche derrière le logo au démarrage à froid
             (l'OS génère seul l'écran de démarrage à partir de windowBackground + icône
             de lancement, avant que Compose ne dessine la première frame). -->
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
